{
  "name": "claude-usage-tray",
  "version": "1.0.9",
  "description": "macOS tray app for Claude Code usage stats",
  "main": "main.js",
  "files": [
    "main.js",
    "auth.js",
    "preload.js",
    "popup.html",
    "popup.js",
    "lib/**/*",
    "fonts/**/*",
    "build/entitlements.mac.plist",
    "build/icon.png"
  ],
  "scripts": {
    "start": "electron .",
    "prebuild": "rm -rf dist",
    "build": "electron-builder --mac",
    "lint": "eslint ."
  },
  "build": {
    "appId": "com.claude.usage-tray",
    "productName": "Claude Usage Tray",
    "files": [
      "main.js",
      "auth.js",
      "preload.js",
      "popup.html",
      "popup.js",
      "lib/**/*",
      "fonts/**/*"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "identity": "Orkhan Huseynov (W898QUYB63)",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "LSUIElement": true
      }
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "electron": "^41.1.0",
    "electron-builder": "^26.8.1",
    "eslint": "^10.2.0",
    "globals": "^17.5.0"
  }
}
